{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor",
  "description": "The Isothrum editor (isothrum.com, or a local build while developing) may run labs and capture their traffic. No other site may.",
  "windows": ["main"],
  "remote": { "urls": ["https://www.isothrum.com/*", "http://localhost:*/*"] },
  "permissions": [
    "core:event:default",
    "allow-desktop-info",
    "allow-lab-up",
    "allow-lab-down",
    "allow-lab-status",
    "allow-capture-start",
    "allow-capture-stop",
    "allow-machine-console",
    "allow-machine-action",
    "allow-snapshot-list",
    "allow-snapshot-take",
    "allow-snapshot-use",
    "allow-snapshot-delete",
    "allow-update-check",
    "allow-update-install"
  ]
}
