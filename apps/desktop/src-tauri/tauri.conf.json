{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Isothrum",
  "version": "0.1.0",
  "identifier": "com.isothrum.desktop",
  "build": {
    "frontendDist": "../editor",
    "beforeBuildCommand": "npm run editor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Draw network labs, run them, capture their traffic.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGRTBGMzJEOTQxMjkyNTMKUldSVGtoS1VMZlBnLzN1RnFmTXFzNStOaUxIRmh3b1hZSC84dW1TVStoZjNwUGtPd2NVbU8wQlUK",
      "endpoints": [
        "https://github.com/isoloom/isothrum/releases/latest/download/latest.json"
      ]
    }
  }
}
