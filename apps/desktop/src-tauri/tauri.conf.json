{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Isothrum",
  "version": "0.1.0",
  "identifier": "com.isothrum.desktop",
  "build": {
    "frontendDist": "../editor",
    "beforeBuildCommand": "npm run editor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "msi"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Draw network labs, run them, capture their traffic.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
