---
source: crates/isothrum-compiler/tests/compile/fixtures.rs
expression: "compiled(\"office-lab\", &[\"docker\"])"
---
version: 1
name: office-lab
networks:
  office:
    cidr: 10.10.1.0/24
  servers:
    cidr: 10.10.2.0/24
reach:
- from: office
  to: servers
- from: servers
  to: office
machines:
  user:
    os: debian@12
    networks:
      office: 10
    access: true
  web:
    app:
      image: nginx:1.27-alpine
    networks:
      servers: 10
    ports:
      http:
        port: 80
        protocol: http
  db:
    os: debian@12
    app:
      steps:
      - run: provision/db.sh
    networks:
      servers: 20
    ports:
      postgres: 5432
